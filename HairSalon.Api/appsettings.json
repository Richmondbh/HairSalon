{
  "SalonName": "Nordic Hair Studio",
  "ConnectionStrings": {
    "SalonDb": "Data Source=salon.db"
  },
  "Jwt": {
    "Issuer": "HairSalon.Api",
    "Audience": "HairSalon.Client",
    "ExpiresInHours": 8
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7100", "http://localhost:5100" ]
  },
  "Reminders": {
    "CheckIntervalMinutes": 5,
    "HoursBefore": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
