<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    HairSalon.Client - the front end.
    A Blazor WebAssembly app: the C# code is downloaded to the browser and runs THERE.
    It has no database access at all; every piece of data comes from HairSalon.Api over HTTP.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 10: fills in the fingerprint placeholders in wwwroot/index.html -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <!-- AuthenticationStateProvider, <AuthorizeView>, [Authorize] for Blazor components -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HairSalon.Shared\HairSalon.Shared.csproj" />
  </ItemGroup>

</Project>
