@* Shows review cards in a grid. Used on the stylist page and on the home page. *@

@if (Reviews.Count == 0)
{
    <p class="text-muted">No reviews yet.</p>
}
else
{
    <div class="row row-cols-1 @ColumnClass g-3">
        @foreach (var review in Reviews)
        {
            <div class="col">
                <div class="card review-card h-100">
                    <div class="card-body">
                        <StarRating Value="review.Rating" />
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p class="mt-2 mb-2">"@review.Comment"</p>
                        }
                        <div class="small text-muted">
                            <strong>@review.CustomerName</strong> &middot; @review.ServiceName
                            @if (ShowStylist)
                            {
                                <span> with <a href="@($"stylists/{review.StylistId}")">@review.StylistName</a></span>
                            }
                            &middot; @review.CreatedAt.ToString("d MMM yyyy")
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<ReviewDto> Reviews { get; set; } = new();
    [Parameter] public bool ShowStylist { get; set; }
    [Parameter] public int Columns { get; set; } = 2;

    private string ColumnClass => Columns switch
    {
        3 => "row-cols-md-3",
        1 => string.Empty,
        _ => "row-cols-md-2"
    };
}
