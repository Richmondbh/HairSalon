@inject NavigationManager Navigation
@*
    Used by App.razor when a page has [Authorize] and nobody is logged in.
    It sends the user to the login page and remembers where they wanted to go
    (returnUrl), so they come back there after logging in.
*@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
