@* Shows the customer's loyalty tier, points and progress to the next tier. *@

<div class="card loyalty-card tier-card-@Loyalty.Tier.ToLower()">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <div class="small text-uppercase opacity-75">Loyalty programme</div>
                <div class="h3 mb-0"><i class="bi bi-gem"></i> @Loyalty.Tier</div>
            </div>
            <div class="text-end">
                <div class="h3 mb-0">@Loyalty.Points</div>
                <div class="small opacity-75">points</div>
            </div>
        </div>

        @if (Loyalty.NextTier != null)
        {
            <div class="progress mb-2" role="progressbar" aria-valuenow="@Progress" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @Progress%"></div>
            </div>
            <div class="small">@Loyalty.PointsToNextTier points to <strong>@Loyalty.NextTier</strong></div>
        }
        else
        {
            <div class="small">You have reached the highest tier - thank you for being a loyal customer!</div>
        }

        <hr class="opacity-25" />
        <div class="d-flex justify-content-between small">
            <span>@Loyalty.CompletedVisits visits &middot; @Format.Price(Loyalty.TotalSpent) spent</span>
            <span>
                @if (Loyalty.DiscountPercent > 0)
                {
                    <strong>@Loyalty.DiscountPercent% off every booking</strong>
                }
                else
                {
                    <span>Silver = 5% off</span>
                }
            </span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public LoyaltySummaryDto Loyalty { get; set; } = default!;

    /// <summary>How far (in %) the customer has come from the current tier to the next.</summary>
    private int Progress
    {
        get
        {
            var (from, to) = Loyalty.Tier switch
            {
                "Bronze" => (0, LoyaltyRules.SilverThreshold),
                "Silver" => (LoyaltyRules.SilverThreshold, LoyaltyRules.GoldThreshold),
                _ => (LoyaltyRules.GoldThreshold, LoyaltyRules.GoldThreshold)
            };
            return to == from ? 100 : Math.Clamp((Loyalty.Points - from) * 100 / (to - from), 0, 100);
        }
    }
}
