@page "/register"
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation

<PageTitle>Create account | Nordic Hair Studio</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card auth-card">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 text-center mb-1">Create your account</h1>
                <p class="text-center text-muted mb-4">Book online, get reminders and collect loyalty points.</p>

                <AlertMessage @bind-Message="_error" />

                <EditForm Model="_model" OnValidSubmit="RegisterAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="first">First name</label>
                            <InputText id="first" class="form-control" autocomplete="given-name" @bind-Value="_model.FirstName" />
                            <ValidationMessage For="() => _model.FirstName" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="last">Last name</label>
                            <InputText id="last" class="form-control" autocomplete="family-name" @bind-Value="_model.LastName" />
                            <ValidationMessage For="() => _model.LastName" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="email">Email</label>
                            <InputText id="email" type="email" class="form-control" autocomplete="email" @bind-Value="_model.Email" />
                            <ValidationMessage For="() => _model.Email" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="phone">Phone <span class="text-muted small">(optional)</span></label>
                            <InputText id="phone" type="tel" class="form-control" autocomplete="tel" @bind-Value="_model.PhoneNumber" />
                            <ValidationMessage For="() => _model.PhoneNumber" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="password">Password</label>
                            <InputText id="password" type="password" class="form-control" autocomplete="new-password" @bind-Value="_model.Password" />
                            <ValidationMessage For="() => _model.Password" />
                            <div class="form-text">At least 6 characters with an upper-case letter, a lower-case letter and a digit.</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="confirm">Confirm password</label>
                            <InputText id="confirm" type="password" class="form-control" autocomplete="new-password" @bind-Value="_model.ConfirmPassword" />
                            <ValidationMessage For="() => _model.ConfirmPassword" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-salon w-100 mt-4" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Create account
                    </button>
                </EditForm>

                <p class="text-center mt-4 mb-0">
                    Already have an account? <a href="login">Log in</a>
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly RegisterDto _model = new();
    private string? _error;
    private bool _busy;

    private async Task RegisterAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            // The API creates the user, gives them the Customer role and returns a token,
            // so the new customer is logged in straight away.
            await AuthApi.RegisterAsync(_model);
            Navigation.NavigateTo("");
        }
        catch (ApiException ex)
        {
            // e.g. "An account with this email already exists." or Identity's password rules.
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
