@page "/"

<PageTitle>Nordic Hair Studio</PageTitle>

<section class="hero">
    <div class="hero-content">
        <p class="hero-kicker">Hair salon in Östersund</p>
        <h1>Look good. Feel even better.</h1>
        <p class="lead">
            Precision cuts, beautiful colour and styling for every occasion.
            Book your appointment online in less than a minute.
        </p>
        <div class="d-flex flex-wrap gap-2">
        </div>
    </div>
</section>

<section class="row g-4 text-center mb-5">
    <div class="col-md-4">
        <div class="feature">
            <i class="bi bi-calendar2-check"></i>
            <h2 class="h5">Easy online booking</h2>
            <p class="text-muted">Pick a service, a stylist and a free time - done.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature">
            <i class="bi bi-stars"></i>
            <h2 class="h5">Experienced stylists</h2>
            <p class="text-muted">Our team has more than 35 years of combined experience.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature">
            <i class="bi bi-gem"></i>
            <h2 class="h5">Rewards for regulars</h2>
            <p class="text-muted">Collect points on every visit and get member discounts.</p>
        </div>
    </div>
</section>
