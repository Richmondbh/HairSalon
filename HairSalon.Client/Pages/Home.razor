@page "/"
@inject ServiceApiClient ServiceApi
@inject StylistApiClient StylistApi
@inject ReviewApiClient ReviewApi

<PageTitle>Nordic Hair Studio</PageTitle>

<section class="hero">
    <div class="hero-content">
        <p class="hero-kicker">Hair salon in Östersund</p>
        <h1>Look good. Feel even better.</h1>
        <p class="lead">
            Precision cuts, beautiful colour and styling for every occasion.
            Book your appointment online in less than a minute.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a href="book" class="btn btn-gold btn-lg"><i class="bi bi-calendar-plus"></i> Book an appointment</a>
            <a href="services" class="btn btn-outline-light btn-lg">See services &amp; prices</a>
        </div>
    </div>
</section>

@* Personal recommendations - only for logged-in customers. *@
<AuthorizeView Roles="@Roles.Customer">
    @if (_recommended?.Count > 0)
    {
        <section class="mb-5">
            <div class="section-title">
                <h2>Recommended for you, @context.User.FindFirst("given_name")?.Value</h2>
                <a href="profile">Your loyalty status <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var service in _recommended)
                {
                    <div class="col">
                        <ServiceCard Service="service">
                            <a class="btn btn-sm btn-salon" href="@($"book?serviceId={service.ServiceId}")">Book</a>
                        </ServiceCard>
                    </div>
                }
            </div>
        </section>
    }
</AuthorizeView>

<section class="mb-5">
    <div class="section-title">
        <h2>Most popular services</h2>
        <a href="services">All services <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (_popular == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var service in _popular)
            {
                <div class="col">
                    <ServiceCard Service="service">
                        <a class="btn btn-sm btn-salon" href="@($"book?serviceId={service.ServiceId}")">Book</a>
                    </ServiceCard>
                </div>
            }
        </div>
    }
</section>

<section class="mb-5">
    <div class="section-title">
        <h2>Meet our top-rated stylists</h2>
        <a href="stylists">The whole team <i class="bi bi-arrow-right"></i></a>
    </div>
    @if (_stylists == null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var stylist in _stylists)
            {
                <div class="col">
                    <StylistCard Stylist="stylist" Compact="true" />
                </div>
            }
        </div>
    }
</section>

@if (_reviews?.Count > 0)
{
    <section class="mb-5">
        <div class="section-title">
            <h2>What our customers say</h2>
        </div>
        <ReviewList Reviews="_reviews" ShowStylist="true" Columns="3" />
    </section>
}

<section class="opening-hours card">
    <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h2 class="h5 mb-1"><i class="bi bi-clock"></i> Opening hours</h2>
            <p class="mb-0 text-muted">
                Monday-Saturday @SalonHours.OpeningTime.ToString("HH:mm")-@SalonHours.ClosingTime.ToString("HH:mm") &middot; Closed on Sundays
            </p>
        </div>
        <a href="book" class="btn btn-salon">Find a free time</a>
    </div>
</section>

@code {
    private List<ServiceDto>? _popular;
    private List<ServiceDto>? _recommended;
    private List<StylistDto>? _stylists;
    private List<ReviewDto>? _reviews;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Start the requests at the same time and wait for all of them (faster than one by one).
        var popularTask = ServiceApi.GetPopularAsync(3);
        var stylistsTask = StylistApi.GetTopRatedAsync(3);
        var reviewsTask = ReviewApi.GetLatestAsync(3);

        try
        {
            await Task.WhenAll(popularTask, stylistsTask, reviewsTask);
            _popular = popularTask.Result;
            _stylists = stylistsTask.Result;
            _reviews = reviewsTask.Result;
        }
        catch (ApiException)
        {
            // The footer already shows "API offline"; show empty sections instead of spinners.
            _popular ??= new();
            _stylists ??= new();
            _reviews ??= new();
        }

        if (AuthState != null && (await AuthState).User.IsInRole(Roles.Customer))
        {
            try { _recommended = await ServiceApi.GetRecommendedAsync(3); }
            catch (ApiException) { _recommended = null; }
        }
    }
}
