@page "/services"
@inject ServiceApiClient ServiceApi

<PageTitle>Services & prices | Nordic Hair Studio</PageTitle>

<div class="page-header">
    <h1>Services &amp; prices</h1>
    <p class="lead text-muted">Search for a treatment or filter by category.</p>
</div>

@*
    PARENT component: it owns the data (_search, _category, _services) and passes it DOWN to
    the child components as parameters. The children send changes back UP through
    ValueChanged / SelectedChanged, and the parent reloads the list.
*@
<div class="row g-3 align-items-center mb-4">
    <div class="col-lg-5">
        <SearchBox Value="@_search" ValueChanged="OnSearchChangedAsync" Placeholder="Search by name or description..." />
    </div>
    <div class="col-lg-7">
        <CategoryFilter Selected="_category" SelectedChanged="OnCategoryChangedAsync" />
    </div>
</div>

<AlertMessage @bind-Message="_error" />

@if (_services == null)
{
    <LoadingSpinner Text="Loading services..." />
}
else if (_services.Count == 0)
{
    <EmptyState Icon="bi-search" Title="No services found" Text="Try another search word or category." />
}
else
{
    <p class="text-muted small mb-3">@_services.Count service@(_services.Count == 1 ? "" : "s") found</p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var service in _services)
        {
            <div class="col">
                <ServiceCard Service="service">
                </ServiceCard>
            </div>
        }
    </div>
}

@code {
    private List<ServiceDto>? _services;
    private string? _search;
    private ServiceCategory? _category;
    private string? _error;

    // Lifecycle method: runs once when the page is first shown.
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _error = null;
            // Searching and filtering happen on the SERVER (in the SQL query).
            _services = await ServiceApi.GetAllAsync(_search, _category);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _services = new();
        }
    }

    private async Task OnSearchChangedAsync(string? search)
    {
        _search = search;
        await LoadAsync();
    }

    private async Task OnCategoryChangedAsync(ServiceCategory? category)
    {
        _category = category;
        await LoadAsync();
    }
}
