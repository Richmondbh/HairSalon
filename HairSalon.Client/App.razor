@*
    App.razor - the root component. The Router looks at the URL and finds the page
    (a component with a matching @page directive).
*@
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* AuthorizeRouteView = RouteView + it checks [Authorize] attributes on the page. *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-shield-lock display-4 text-muted"></i>
                        <h1 class="h3 mt-3">Access denied</h1>
                        <p class="text-muted">You do not have permission to view this page.</p>
                        <a href="" class="btn btn-salon">Back to the home page</a>
                    </div>
                }
            </NotAuthorized>
            <Authorizing>
                <LoadingSpinner Text="Checking your login..." />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="text-center py-5">
                <i class="bi bi-signpost-split display-4 text-muted"></i>
                <h1 class="h3 mt-3">Page not found</h1>
                <p class="text-muted">Sorry, there is nothing at this address.</p>
                <a href="" class="btn btn-salon">Back to the home page</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
